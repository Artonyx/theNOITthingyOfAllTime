  - m_Id: 11399166841225216
    m_Localized: "\u041F\u0440\u0438\u0440\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 11404122814054400
    m_Localized: "\u041D\u0438\u0432\u043E\u0442\u043E \u0432\u0441\u0435 \u043E\u0449\u0435
      \u043D\u0435 \u0435 \u0434\u043E\u0441\u0442\u044A\u043F\u043D\u043E :(\n\u041E\u0447\u0430\u043A\u0432\u0430\u0439\u0442\u0435
      \u0441\u043A\u043E\u0440\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 11404726693167104
    m_Localized: "\u0414\u043E\u0431\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 11414503770980352
    m_Localized: "\u0418\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u043D\u0438\u0432\u043E:"
    m_Metadata:
      m_Items: []
  - m_Id: 11814527773294592
    m_Localized: "\u041A\u0440\u0435\u0434\u0438\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 11820904394637312
    m_Localized: "\u041E\u0449\u0435 \u0438\u043D\u0444\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 11829234638897152
    m_Localized: "\u0422\u0430\u0437\u0438 \u0438\u0433\u0440\u0430 \u0435 \u0441\u044A\u0437\u0434\u0430\u0434\u0435\u043D\u0430
      \u043E\u0442 \u0434\u0432\u0430\u043C\u0430 \u0443\u0447\u0435\u043D\u0438\u0446\u0438
      \u043E\u0442 \u041F\u0440\u043E\u0444\u0438\u043B\u0438\u0440\u0430\u043D\u0430\u0442\u0430
      \u043F\u0440\u0438\u0440\u043E\u0434\u043E\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430
      \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u044F \"\u0410\u043A\u0430\u0434\u0435\u043C\u0438\u043A
      \u041D\u0438\u043A\u043E\u043B\u0430 \u041E\u0431\u0440\u0435\u0448\u043A\u043E\u0432\"
      \u0432 \u0433\u0440\u0430\u0434 \u0411\u0443\u0440\u0433\u0430\u0441, \u0411\u044A\u043B\u0433\u0430\u0440\u0438\u044F
      - \u0410\u043D\u043D\u0430-\u041C\u0430\u0440\u0438\u044F \u0414\u0430\u043B\u0430\u043A\u043C\u0430\u043D\u043E\u0432\u0430
      \u043E\u0442 11 \u0434 \u043A\u043B\u0430\u0441 \u0438 \u041C\u0438\u0440\u043E\u0441\u043B\u0430\u0432
      \u041A\u0430\u0432\u0440\u044A\u043A\u043E\u0432 \u043E\u0442 12 \u0434 \u043A\u043B\u0430\u0441.\n\n\u0414\u0438\u0437\u0430\u0439\u043D
      \u043D\u0430 \u0438\u0433\u0440\u0430\u0442\u0430, \u0441\u043F\u0440\u0430\u0439\u0442\u043E\u0432\u0435
      \u0438 \u0444\u0440\u043E\u043D\u0442 \u0435\u043D\u0434 - \u0410\u043D\u043D\u0430-\u041C\u0430\u0440\u0438\u044F\n\u0418\u0434\u0435\u044F,
      \u0434\u0438\u0437\u0430\u0439\u043D \u043D\u0430 \u043D\u0438\u0432\u0430\u0442\u0430
      \u0438 \u0431\u0435\u043A \u0435\u043D\u0434 - \u041C\u0438\u0440\u043E\u0441\u043B\u0430\u0432\n\n\u0414\u0440\u0443\u0433\u0438
      \u0440\u0435\u0441\u0443\u0440\u0441\u0438:\nUnity documentation, Unity \u0444\u043E\u0440\u0443\u043C\u0438,
      Stack Overflow, YouTube"
    m_Metadata:
      m_Items: []
  - m_Id: 12132808613855232
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u0430 \u0412\u0438 \u0435 \u043D\u0430
      \u043F\u0430\u0443\u0437\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 12133885467852800
    m_Localized: "\u0420\u0435\u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0439\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12134618007240704
    m_Localized: "\u041F\u0440\u043E\u0434\u044A\u043B\u0436\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12135025899110400
    m_Localized: "\u0418\u0437\u043B\u0435\u0437\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12147568252190720
    m_Localized: "\u0412\u044A\u0437\u043E\u0431\u043D\u043E\u0432\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 13222818226274304
    m_Localized: "\u0418\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13237038363869184
    m_Localized: "\u0411\u0438\u0445\u0442\u0435 \u043B\u0438 \u0436\u0435\u043B\u0430\u043B\u0438
      \u0432\u044A\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043A\u044A\u043C \u0438\u0433\u0440\u0430\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 13237341918232576
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13237448961064960
    m_Localized: "\u041D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 13237650136662016
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0435.
      \u041F\u0440\u0438\u044F\u0442\u043D\u0430 \u0438\u0433\u0440\u0430 :)"
    m_Metadata:
      m_Items: []
  - m_Id: 13237978571636736
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0435.
      \u0414\u043E\u0431\u0440\u0435 \u0434\u043E\u0448\u043B\u0438 \u0432 \u041F\u043E\u0436\u0430\u0440\u043E-\u0433\u0430\u0441\u0438\u0442\u0435\u043B!
      \u0422\u043E\u0432\u0430 \u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043A\u0430
      \u0438\u0433\u0440\u0430, \u0432 \u043A\u043E\u044F\u0442\u043E \u043F\u043E\u0435\u043C\u0430\u0442\u0435
      \u0440\u043E\u043B\u044F\u0442\u0430 \u043D\u0430 \u0434\u0438\u0441\u043F\u0435\u0447\u0435\u0440
      \u043D\u0430 \u043F\u043E\u0436\u0430\u0440\u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 13238398094311424
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0442\u0435 \u0441\u0430
      \u043F\u0440\u043E\u0441\u0442\u0438; \u0438\u0437\u0431\u0438\u0440\u0430\u0442\u0435
      \u0438 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0442\u0435 \u0432\u044A\u0440\u0445\u0443
      \u043F\u043E\u0436\u0430\u0440\u043D\u0430 \u043A\u043E\u043B\u0430 \u0438
      \u045D \u0434\u0430\u0432\u0430\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0430,
      \u043A\u043E\u0433\u0430\u0442\u043E \u0438\u043C\u0430 \u0430\u043A\u0442\u0438\u0432\u0435\u043D
      \u043F\u043E\u0436\u0430\u0440 \u0432 \u0433\u0440\u0430\u0434\u0430. \u0422\u0440\u044F\u0431\u0432\u0430
      \u0434\u0430 \u043F\u0440\u0430\u0432\u0438\u0442\u0435 \u0442\u043E\u0432\u0430
      \u0437\u0430 \u0435\u0434\u0438\u043D \u0434\u0435\u043D \u0432 \u0433\u0440\u0430\u0434\u0430,
      \u043D\u043E \u0449\u0435 \u0412\u0438 \u043E\u0442\u043D\u0435\u043C\u0435
      1 \u043C\u0438\u043D\u0443\u0442\u0430 \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 13239190616440832
    m_Localized: "\u0422\u043E\u0432\u0430 \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430
      \u0435 \u0432\u0441\u0438\u0447\u043A\u043E! \u041F\u0440\u0438\u044F\u0442\u043D\u0430
      \u0438\u0433\u0440\u0430 :)"
    m_Metadata:
      m_Items: []
  - m_Id: 13919542129360896
    m_Localized: "\u0412\u0438\u0435 \u0441\u043F\u0435\u0447\u0435\u043B\u0438\u0445\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 13920161850359808
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F!
      \u0412\u0438\u0435 \u043F\u0440\u0435\u043C\u0438\u043D\u0430\u0445\u0442\u0435
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u044A\u0447\u043D\u043E\u0442\u043E
      \u043D\u0438\u0432\u043E. "
    m_Metadata:
      m_Items: []
  - m_Id: 13921586093391872
    m_Localized: "\u0417\u0430\u0433\u0443\u0431\u0438\u0445\u0442\u0435 :("
    m_Metadata:
      m_Items: []
  - m_Id: 13921556406108160
    m_Localized: "\u041D\u043E \u043D\u0435 \u0441\u0435 \u043E\u0442\u043A\u0430\u0437\u0432\u0430\u0439\u0442\u0435
      \u0432\u0441\u0435 \u043E\u0449\u0435! \u0418\u0441\u043A\u0430\u0442\u0435
      \u043B\u0438 \u0434\u0430 \u043E\u043F\u0438\u0442\u0430\u0442\u0435 \u043E\u0442\u043D\u043E\u0432\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 13963582757568512
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 14687727539617792
    m_Localized: "\u0421\u0438\u0433\u0443\u0440\u043D\u0438 \u043B\u0438 \u0441\u0442\u0435,
      \u0447\u0435 \u0438\u0441\u043A\u0430\u0442\u0435 \u0434\u0430 \u0438\u0437\u043B\u0435\u0437\u0435\u0442\u0435
      \u043E\u0442 \u0438\u0433\u0440\u0430\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 14688864175030272
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 14688980210450432
    m_Localized: "\u041D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14689500111208448
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 16975134720950272
    m_Localized: "\u041A\u0430\u043A\u0432\u043E \u0431\u0438\u0445\u0442\u0435 \u0436\u0435\u043B\u0430\u043B\u0438
      \u0434\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u0435 \u0441
      \u0442\u0430\u0437\u0438 \u043F\u043E\u0436\u0430\u0440\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 16975449138561024
    m_Localized: "[\u0415] \u0413\u0430\u0441\u0435\u0442\u0435 \u043F\u043E\u0436\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 16976039826587648
    m_Localized: "[\u042F] \u041F\u0440\u0435\u043C\u0435\u0441\u0442\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 16977552468770816
    m_Localized: "[\u0412] \u0421\u043F\u0440\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 17033159401963520
    m_Localized: "\u041E\u0442\u043A\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 17599111797571584
    m_Localized: "\u0416\u0435\u0440\u0442\u0432\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 17600159576653824
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0430\u0449\u043E \u0432\u0440\u0435\u043C\u0435:"
    m_Metadata:
      m_Items: []
  - m_Id: 17617180578185216
    m_Localized: "\u0412\u0410\u0416\u041D\u041E!!\n\u041F\u0440\u0438 \u043F\u043E\u0436\u0430\u0440
      \u043D\u0430\u0439-\u043F\u043E\u0434\u0446\u0435\u043D\u0435\u043D\u0438\u044F\u0442
      \u0444\u0430\u043A\u0442\u043E\u0440 \u0441\u0430 \u043E\u0442\u0440\u043E\u0432\u043D\u0438\u0442\u0435
      \u0433\u0430\u0437\u043E\u0432\u0435. \n\u041F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0435\u043D
      \u043F\u043E\u0436\u0430\u0440 \u0432 \u0431\u043B\u043E\u043A\u043E\u0432\u043E\u0442\u043E
      \u0436\u0438\u043B\u0438\u0449\u0435, \u041D\u0415 \u0421\u0415 \u0418\u0417\u041B\u0418\u0417\u0410
      \u041E\u0422 \u0416\u0418\u041B\u0418\u0429\u0415\u0422\u041E, \u0414\u041E\u041A\u0410\u0422\u041E
      \u041D\u0415 \u0414\u041E\u0419\u0414\u0410\u0422 \u041F\u041E\u0416\u0410\u0420\u041D\u0418\u041A\u0410\u0420\u0418\u0422\u0415.
      \u0421\u043B\u0430\u0433\u0430\u0442 \u0441\u0435 \u043C\u043E\u043A\u0440\u0438
      \u043A\u044A\u0440\u043F\u0438 \u043D\u0430 \u044A\u0433\u043B\u0438\u0442\u0435
      \u043D\u0430 \u0444\u0443\u0433\u0438\u0442\u0435 \u043D\u0430 \u0432\u0440\u0430\u0442\u0430\u0442\u0430
      \u0438 \u0447\u043E\u0432\u0435\u043A \u0442\u0440\u044F\u0431\u0432\u0430
      \u0434\u0430 \u0441\u0435 \u0437\u0430\u0442\u0432\u043E\u0440\u0438 \u0432
      \u0431\u0430\u043D\u044F\u0442\u0430 \u0411\u0415\u0417 \u0414\u0410 \u0421\u0415
      \u041F\u0423\u0421\u041A\u0410\u0422 \u041D\u0418\u041A\u0410\u041A\u0412\u0418
      \u0412\u0415\u041D\u0422\u0418\u041B\u0410\u0426\u0418\u0418. \u041C\u043E\u043A\u044A\u0440
      \u043F\u0430\u0440\u0446\u0430\u043B \u043D\u0430 \u043B\u0438\u0446\u0435\u0442\u043E
      \u0435 \u0437\u0430\u0434\u044A\u043B\u0436\u0438\u0442\u0435\u043B\u0435\u043D.
      \n\n\u041A\u0430\u043A\u0432\u043E \u0434\u0430 \u041D\u0415 \u0441\u0435 \u043F\u0440\u0430\u0432\u0438\n\u2022
      \u041D\u0435 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u0439\u0442\u0435
      \u0430\u0441\u0430\u043D\u0441\u044C\u043E\u0440 \u043F\u0440\u0438 \u043F\u043E\u0436\u0430\u0440.\n\u2022
      \u041D\u0435 \u0433\u0430\u0441\u0435\u0442\u0435 \u043C\u0430\u0437\u043D\u0438\u043D\u0435\u043D
      \u043F\u043E\u0436\u0430\u0440 \u0441 \u0432\u043E\u0434\u0430 (\u043F\u043E\u043A\u0440\u0438\u0439\u0442\u0435
      \u0441\u044A\u0434\u0430 \u0441 \u043A\u0430\u043F\u0430\u043A \u0438\u043B\u0438
      \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u0436\u0430\u0440\u043E\u0433\u0430\u0441\u0438\u0442\u0435\u043B).\n\u2022
      \u041D\u0435 \u043E\u0442\u0432\u0430\u0440\u044F\u0439\u0442\u0435 \u0432\u0440\u0430\u0442\u0430
      \u043A\u044A\u043C \u0437\u0430\u0434\u0438\u043C\u0435\u043D\u043E \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u0431\u0435\u0437 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0437\u0430
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430.\n\n\u041F\u0440\u0435\u0432\u0430\u043D\u0442\u0438\u0432\u043D\u0438
      \u043C\u0435\u0440\u043A\u0438:\n\u041D\u0435 \u043F\u0440\u0435\u0442\u043E\u0432\u0430\u0440\u0432\u0430\u0439\u0442\u0435
      \u0440\u0430\u0437\u043A\u043B\u043E\u043D\u0438\u0442\u0435\u043B\u0438 \u0438
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0438 - \u0438\u0437\u0431\u044F\u0433\u0432\u0430\u0439\u0442\u0435
      \u201E\u0440\u0430\u0437\u043A\u043B\u043E\u043D\u0438\u0442\u0435\u043B \u0432
      \u0440\u0430\u0437\u043A\u043B\u043E\u043D\u0438\u0442\u0435\u043B\". \u0422\u044A\u0440\u0441\u0435\u0442\u0435
      \u043D\u0430\u0433\u0440\u044F\u0432\u0430\u043D\u0435, \u043C\u0438\u0440\u0438\u0441
      \u043D\u0430 \u0438\u0437\u0433\u043E\u0440\u044F\u043B\u043E, \u0438\u0441\u043A\u0440\u0435\u043D\u0435.
      \u0418\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u0439\u0442\u0435 \u0434\u0435\u0444\u0435\u043A\u0442\u043D\u043E\u0442\u043E\u043A\u043E\u0432\u0438
      \u0437\u0430\u0449\u0438\u0442\u0438 (RCD) \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438
      \u043F\u0440\u0435\u043A\u044A\u0441\u0432\u0430\u0447\u0438.\n\u041D\u0435
      \u043E\u0441\u0442\u0430\u0432\u044F\u0439\u0442\u0435 \u0433\u043E\u0442\u0432\u0435\u043D\u0435
      \u0431\u0435\u0437 \u043D\u0430\u0434\u0437\u043E\u0440, \u0437\u0430\u0449\u043E\u0442\u043E
      \u043C\u0430\u0437\u043D\u0438\u043D\u0438\u0442\u0435 \u0441\u0435 \u0432\u044A\u0437\u043F\u043B\u0430\u043C\u0435\u043D\u044F\u0432\u0430\u0442
      \u0431\u044A\u0440\u0437\u043E. \u041F\u043E\u0447\u0438\u0441\u0442\u0432\u0430\u0439\u0442\u0435
      \u0430\u0441\u043F\u0438\u0440\u0430\u0442\u043E\u0440\u0438 \u0438 \u0444\u0438\u043B\u0442\u0440\u0438
      \u043E\u0442 \u043D\u0430\u0442\u0440\u0443\u043F\u0430\u043D\u0438 \u043C\u0430\u0437\u043D\u0438\u043D\u0438.
      \u041F\u0440\u0438 \u043F\u0435\u0447\u043A\u0438 \u0438 \u0440\u0430\u0434\u0438\u0430\u0442\u043E\u0440\u0438
      \u2013 \u0441\u043F\u0430\u0437\u0432\u0430\u0439\u0442\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F \u043E\u0442 \u043C\u0435\u0431\u0435\u043B\u0438
      \u0438 \u0437\u0430\u0432\u0435\u0441\u0438. \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u0439\u0442\u0435
      \u0432\u0440\u044A\u0437\u043A\u0438 \u0438 \u043C\u0430\u0440\u043A\u0443\u0447\u0438
      \u0437\u0430 \u0442\u0435\u0447 \u0438 \u043F\u0440\u0438 \u043C\u0438\u0440\u0438\u0441
      \u043D\u0430 \u0433\u0430\u0437 \u2013 \u043F\u0440\u043E\u0432\u0435\u0442\u0440\u0435\u0442\u0435,
      \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0432\u0430\u0439\u0442\u0435 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u0443\u0440\u0435\u0434\u0438
      \u0438 \u0441\u0435 \u043E\u0431\u0430\u0434\u0435\u0442\u0435 \u043D\u0430
      112. \u0418\u043D\u0441\u0442\u0430\u043B\u0438\u0440\u0430\u0439\u0442\u0435
      \u0434\u0435\u0442\u0435\u043A\u0442\u043E\u0440 \u0437\u0430 \u0433\u0430\u0437/\u0432\u044A\u0433\u043B\u0435\u0440\u043E\u0434\u0435\u043D
      \u043E\u043A\u0441\u0438\u0434 \u043F\u0440\u0438 \u043D\u0443\u0436\u0434\u0430.
      \u041C\u043E\u043D\u0442\u0438\u0440\u0430\u0439\u0442\u0435 \u0434\u0438\u043C\u043D\u0438
      \u0434\u0435\u0442\u0435\u043A\u0442\u043E\u0440\u0438 \u0438 \u0442\u0435\u0441\u0442\u0432\u0430\u0439\u0442\u0435
      \u0431\u0430\u0442\u0435\u0440\u0438\u0438\u0442\u0435 \u0435\u0436\u0435\u043C\u0435\u0441\u0435\u0447\u043D\u043E.
      \u041F\u043E\u0434\u0434\u044A\u0440\u0436\u0430\u0439\u0442\u0435 \u043C\u0430\u043B\u044A\u043A
      \u043F\u043E\u0436\u0430\u0440\u043E\u0433\u0430\u0441\u0438\u0442\u0435\u043B
      , \u043A\u043E\u0439\u0442\u043E \u0434\u0430 \u0435 \u043F\u0440\u0430\u0445\u043E\u0432
      \u0438\u043B\u0438 \u0432\u0442\u0435\u0447\u043D\u0435\u043D \u0432\u044A\u0433\u043B\u0435\u0440\u043E\u0434\u0435\u043D
      \u0434\u0438\u043E\u043A\u0441\u0438\u0434, \u0432 \u043A\u0443\u0445\u043D\u044F\u0442\u0430/\u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430
      \u0438 \u0437\u043D\u0430\u0439\u0442\u0435 \u043A\u0430\u043A \u0441\u0435
      \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430.\n\u041F\u0440\u0438 \u043F\u043E\u0436\u0430\u0440
      \u0434\u0430 \u0441\u0435 \u043F\u043E\u043B\u0437\u0432\u0430\u0442 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0442\u0435
      \u0435\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u043E\u043D\u043D\u0438 \u0438\u0437\u0445\u043E\u0434\u0438.
      \u041D\u0435 \u0441\u043A\u043B\u0430\u0434\u0438\u0440\u0430\u0439\u0442\u0435
      \u0432\u0435\u0449\u0438 \u043F\u043E \u0441\u0442\u044A\u043B\u0431\u0438\u0449\u0430
      \u0438 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0438. \u041F\u043E\u0434\u0434\u0440\u044A\u0436\u043A\u0430
      \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u0436\u0430\u0440\u043D\u0438
      \u0432\u0440\u0430\u0442\u0438 (\u0434\u0430 \u0441\u0435 \u0441\u0430\u043C\u043E\u0437\u0430\u0442\u0432\u0430\u0440\u044F\u0442
      \u0438 \u0434\u0430 \u043D\u0435 \u0441\u0435 \u043F\u043E\u0434\u043F\u0438\u0440\u0430\u0442).
      \u0418\u0437\u043F\u0440\u0430\u0432\u043D\u0438 \u0445\u0438\u0434\u0440\u0430\u043D\u0442\u0438
      \u0438 \u043F\u043E\u0436\u0430\u0440\u043E\u0433\u0430\u0441\u0438\u0442\u0435\u043B\u0438
      \u0438 \u0442\u044F\u0445\u043D\u0430 \u0435\u0436\u0435\u0433\u043E\u0434\u043D\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430. \u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
      \u043D\u0430 \u0434\u043E\u043C\u043E\u0443\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B/\u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B
      \u0437\u0430 \u0431\u0430\u0437\u043E\u0432\u0430 \u0440\u0435\u0430\u043A\u0446\u0438\u044F
      \u043F\u0440\u0438 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442. \u042F\u0441\u043D\u0430
      \u0441\u0445\u0435\u043C\u0430 \u0437\u0430 \u0435\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044F
      \u043D\u0430 \u0432\u0438\u0434\u0438\u043C\u0438 \u043C\u0435\u0441\u0442\u0430
      \u0438 \u0435\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u043E\u043D\u043D\u043E
      \u043E\u0441\u0432\u0435\u0442\u043B\u0435\u043D\u0438\u0435.\n\u0421\u0432\u043E\u0431\u043E\u0434\u0435\u043D
      \u0434\u043E\u0441\u0442\u044A\u043F \u0437\u0430 \u043F\u043E\u0436\u0430\u0440\u043D\u0438
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0438 (\u0431\u0435\u0437
      \u043F\u0430\u0440\u043A\u0438\u0440\u0430\u043D\u0435 \u043F\u0440\u0435\u0434
      \u0445\u0438\u0434\u0440\u0430\u043D\u0442\u0438 \u0438 \u0432\u0445\u043E\u0434\u043E\u0432\u0435).
      \u041A\u043E\u043D\u0442\u0440\u043E\u043B \u0432\u044A\u0440\u0445\u0443 \u043D\u0435\u0440\u0435\u0433\u043B\u0430\u043C\u0435\u043D\u0442\u0438\u0440\u0430\u043D\u043E
      \u0438\u0437\u0433\u0430\u0440\u044F\u043D\u0435 \u043D\u0430 \u043E\u0442\u043F\u0430\u0434\u044A\u0446\u0438.
      \u0421\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u0430\u043D\u0435
      \u043D\u0430 \u0440\u0438\u0441\u043A\u043E\u0432\u0435 \u0434\u043E \u0413\u043B\u0430\u0432\u043D\u0430
      \u0434\u0438\u0440\u0435\u043A\u0446\u0438\u044F \u201E\u041F\u043E\u0436\u0430\u0440\u043D\u0430
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442 \u0438 \u0437\u0430\u0449\u0438\u0442\u0430
      \u043D\u0430 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435\u0442\u043E\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 19201583553085440
    m_Localized: "\u041A\u0430\u043A \u0434\u0430 \u0434\u0430\u0432\u0430\u0442\u0435
      \u0437\u0430\u0434\u0430\u0447\u0438? \u041A\u043E\u0433\u0430\u0442\u043E
      \u0441\u0442\u0435 \u043D\u0430\u0442\u0438\u0441\u043D\u0430\u043B\u0438 \u0432\u044A\u0440\u0445\u0443
      \u043F\u043E\u0436\u0430\u0440\u043D\u0430\u0442\u0430, \u043F\u0430\u043D\u0435\u043B
      \u0441 \u0431\u0443\u0442\u043E\u043D\u0438 \u0449\u0435 \u0441\u0435 \u043F\u043E\u044F\u0432\u0438.
      \u0417\u0430 \u0434\u0430 \u045D \u0434\u0430\u0434\u0435\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0430,
      \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0442\u0435 \u0431\u0443\u0442\u043E\u043D/\u0441\u044A\u043E\u0442\u0432\u0435\u0442\u043D\u0438\u044F
      \u043C\u0443 \u043A\u043B\u0430\u0432\u0438\u0448 - [\u042F] \u0437\u0430 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
      [\u0412] \u0437\u0430 \u0441\u043F\u0438\u0440\u0430\u043D\u0435 \u043D\u0430
